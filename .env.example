# Copy to apps/studio/.env.local for local development. Never commit real values.
# Both are public by design (row-level security protects the data); secret keys never go here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (never NEXT_PUBLIC). Cloudflare R2 holds every recording and render.
# Set these in Vercel (Studio) and Railway (workers). See docs/setup/r2.md.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# "eu" if the bucket was created with the EU jurisdiction, otherwise leave empty.
R2_JURISDICTION=
