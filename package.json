{
  "name": "multi-media-os",
  "private": true,
  "packageManager": "npm@10.9.0",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/orchestrator"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check:size": "node scripts/check-file-size.mjs",
    "check:deps": "depcruise apps packages services --config .dependency-cruiser.cjs",
    "check": "npm run check:size && npm run check:deps && npm run typecheck && npm run test",
    "check:e2e": "tsx services/orchestrator/scripts/check-e2e.ts"
  },
  "devDependencies": {
    "dependency-cruiser": "^16.10.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.2"
  }
}
